<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.caremodels</package>
	<author>slubwama</author>
	<description>
			${project.parent.description}
	</description>

	<activator>org.openmrs.module.caremodels.CareModelsActivator</activator>

	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->

	<require_version>${openmrsPlatformVersion}</require_version>

	<!-- Extensions -->
	<require_modules>
		<require_module>
			org.openmrs.module.webservices.rest
		</require_module>
		<require_module>
			org.openmrs.module.initializer
		</require_module>
	</require_modules>

	<globalProperty>
		<!-- Serializer whitelist global property -->
		<property>${project.parent.artifactId}.serializer.whitelist.types</property>

		<!-- Comma-separated list of fully qualified classes that XStream should be allowed to deserialize -->
		<defaultValue>
			org.openmrs.module.caremodels.**
		</defaultValue>

		<description>
			Whitelist caremodels classes for XStream deserialization (TRUNK-6188)
		</description>
	</globalProperty>

	<!-- Filtered clinical writes are dispatched after their transaction commits. -->
	<advice>
		<point>org.openmrs.api.ProgramWorkflowService</point>
		<class>org.openmrs.module.caremodels.event.ProgramWorkflowServiceAdvice</class>
	</advice>
	<advice>
		<point>org.openmrs.api.EncounterService</point>
		<class>org.openmrs.module.caremodels.event.EncounterServiceAdvice</class>
	</advice>
	<advice>
		<point>org.openmrs.api.ObsService</point>
		<class>org.openmrs.module.caremodels.event.ObsServiceAdvice</class>
	</advice>

	<!-- Servlets -->
	<!-- Accessed through the url /pageContext()/moduleServlet/<moduleId>/<servlet-name>
	<servlet>
		<servlet-name>caremodelsServlet</servlet-name>
		<servlet-class>@MODULE_PACKAGE@.web.CareModelsServlet</servlet-class>
	</servlet>
	-->
	<!-- /Servlets -->

	<!-- Internationalization -->
	<!-- All message codes should start with @MODULE_ID@.* -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->

</module>
